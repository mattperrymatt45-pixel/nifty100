    },
    {
      "name": "GET /api/v1/market-cap/{ticker} \u2014 Historical valuation multiples (2019-2024)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/market-cap/{ticker}",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "market-cap",
            "{ticker}"
          ]
        },
        "description": "Return annual market-cap, P/E, P/B, EV/EBITDA and dividend yield for\nthe company from calendar year 2019 through 2024. Returns 404 for an\nunknown ticker or a company with no market-cap rows in that window."
      }
    },
    {
      "name": "GET /api/v1/portfolio/stats \u2014 Portfolio percentile statistics across all 92 companies",
