            "sectors",
            "{sector}",
            "companies"
          ]
        },
        "description": "Return all companies in a broad sector with latest-year KPIs.\nReturns 404 for an unknown sector name."
      }
    },
    {
      "name": "GET /api/v1/peers/{group_name} \u2014 Get peer group members with percentiles",
