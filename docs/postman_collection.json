{
  "info": {
    "name": "Nifty 100 Financial Intelligence Platform API",
    "_postman_id": "a1b2c3d4-0000-0000-0000-nifty100api00",
    "description": "REST API for querying Nifty 100 financial data, analytics, screener results, peer comparisons, valuation, and portfolio intelligence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET /api/v1/health \u2014 Service health check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/health",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "health"
          ]
        },
        "description": "Return service status, table row counts, uptime, and version.\n\nReturns 200 OK when the server can connect to the SQLite database and\nrun a count query. Returns 503 if the database is unreachable."
      }
    },
    {
      "name": "GET /api/v1/companies/ \u2014 List all companies",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/companies/",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "companies"
          ]
        },
        "description": "Return list of all companies (default) filtered by any of the\nquery parameters. Each item includes id, name, sector, sub_sector,\nmarket_cap_category, and latest-year ROE / ROCE percentages."
      }
    },
    {
      "name": "GET /api/v1/companies/{ticker} \u2014 Get company profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8000/api/v1/companies/{ticker}",
          "host": [
            "localhost"
          ],
          "port": "8000",
          "path": [
            "api",
            "v1",
            "companies",
            "{ticker}"
          ]
        },
        "description": "Return the full company profile: companies.* fields, sector data,\nand latest-year KPIs (financial_ratios + market_cap). Returns 404 if\nthe ticker is not found."
      }
    },
