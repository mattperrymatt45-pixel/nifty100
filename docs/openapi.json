    "/api/v1/companies/{ticker}/documents": {
      "get": {
        "tags": [
          "Documents"
        ],
        "summary": "List annual reports for a company",
        "description": "Return annual report links per fiscal year for the given company.\n\nEach entry contains ``year``, ``url`` and ``is_url_valid``. When\n``?check-urls=true`` is supplied, URLs are probed with a lightweight\nHEAD request (2-second timeout); otherwise validity is inferred from\nthe presence of a ``/missing/`` path token in the source URL (fast).",
        "operationId": "get_company_documents_api_v1_companies__ticker__documents_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Ticker"
            }
          },
          {
            "name": "check-urls",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "If true, perform a live URL HEAD check (slower).",
              "default": false,
