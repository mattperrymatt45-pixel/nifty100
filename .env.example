# =============================================================================
# Nifty 100 Financial Intelligence Platform - Environment Configuration
# Copy this file to .env and update values as needed.
# =============================================================================

# --- Base Directories ---
# Relative paths are resolved from project root. Use absolute paths for production.
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
INTERIM_DATA_DIR=data/interim
OUTPUT_DIR=output
REPORTS_DIR=reports
LOGS_DIR=logs
DB_DIR=db

# --- Database Configuration ---
DB_PATH=db/nifty100.db
DB_CONNECTION_STRING=sqlite:///db/nifty100.db

# --- Logging ---
# Log levels: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/nifty100.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Dashboard Configuration ---
DASHBOARD_PORT=8501
